<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Agent Signaler Dashboard"
           Manufacturer="Agent Signaler"
           Version="$(var.ProductVersion)"
           UpgradeCode="D67CE744-C442-473A-B751-CA70D3CBCA4D"
           Scope="perUser"
           InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Agent Signaler Dashboard is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="PREREQUISITE_WARNING" Value="Direct MSI detects prerequisites only; it does not install or validate their trust. Use AgentSignaler.Dashboard.Setup.exe. Azure CLI 2.90.0+ Microsoft-signed x64 az.exe, the qualified Dev Tunnels CLI, and Windows App 2.0.804.0+ with ms-cloudpc registration are required for their respective features. Dashboard validates trust at use. No sign-in is performed." />
    <Property Id="AZURE_CLI_MSI_VERSION">
      <RegistrySearch Id="FindAzureCliMsi" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\$(var.AzureCliProductCode)"
                      Name="DisplayVersion" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="AZURE_CLI_EXE">
      <DirectorySearch Id="FindAzureCliDirectory" Path="[ProgramFiles64Folder]Microsoft SDKs\Azure\CLI2\wbin" Depth="0">
        <FileSearch Id="FindAzureCliExe" Name="az.exe" MinVersion="$(var.AzureCliVersion)" />
      </DirectorySearch>
    </Property>
    <Property Id="DEVTUNNELS_WINGET_EXE">
      <DirectorySearch Id="FindWinGetDirectory" Path="[LocalAppDataFolder]Microsoft\WinGet\Links" Depth="0">
        <FileSearch Id="FindWinGetCli" Name="devtunnel.exe" MinVersion="$(var.DevTunnelsFileVersion)" />
      </DirectorySearch>
    </Property>
    <Property Id="DEVTUNNELS_PREREQUISITE_EXE">
      <DirectorySearch Id="FindDevTunnelsDirectory" Path="[LocalAppDataFolder]Programs\Microsoft Dev Tunnels CLI" Depth="0">
        <FileSearch Id="FindPrerequisiteCli" Name="devtunnel.exe" MinVersion="$(var.DevTunnelsFileVersion)" />
      </DirectorySearch>
    </Property>
    <Property Id="WINDOWS_APP_PROTOCOL">
      <RegistrySearch Id="FindWindowsAppProtocol" Root="HKCR" Key="ms-cloudpc" Name="URL Protocol" Type="raw" />
    </Property>
    <Property Id="WINDOWS_APP_MINIMUM_VERSION" Value="$(var.WindowsAppMinimumVersion)" />
    <UI>
      <ProgressText Action="AppSearch" Message="Warning: direct MSI does not install prerequisites. See PREREQUISITE_WARNING and detection properties in the verbose MSI log." />
    </UI>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="AgentSignalerFolder" Name="AgentSignaler">
          <Directory Id="INSTALLFOLDER" Name="Dashboard" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Agent Signaler">
        <Component Id="DashboardShortcut" Guid="EA56FD03-9D11-45A9-9D52-D901582633B9">
          <Shortcut Id="DashboardStartMenu" Name="Agent Signaler Dashboard"
                    Target="[INSTALLFOLDER]AgentSignaler.Dashboard.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveDashboardStartMenuFolder" On="uninstall" />
          <RemoveFolder Id="RemoveDashboardInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
          <RemoveFolder Id="RemoveDashboardVendorFolder" Directory="AgentSignalerFolder" On="uninstall" />
          <RemoveFolder Id="RemoveDashboardProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AgentSignaler\Installer\Dashboard"
                         Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <SetProperty Id="IntegrationTransaction" Value="[ProductCode]|[Date]|[Time]"
                 Before="InstallInitialize" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="RollbackDashboardIntegration" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]AgentSignaler.Dashboard.exe&quot; --rollback-uninstall-integration --transaction-id &quot;[IntegrationTransaction]&quot;"
                  Execute="rollback" Impersonate="yes" Return="check" />
    <CustomAction Id="RemoveDashboardIntegration" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]AgentSignaler.Dashboard.exe&quot; --uninstall-integration --transaction-id &quot;[IntegrationTransaction]&quot;"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RollbackDashboardIntegration" Before="RemoveDashboardIntegration"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveDashboardIntegration" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <Feature Id="Main" Title="Agent Signaler Dashboard">
      <ComponentGroupRef Id="DashboardFiles" />
      <ComponentRef Id="DashboardShortcut" />
    </Feature>
  </Package>
</Wix>
