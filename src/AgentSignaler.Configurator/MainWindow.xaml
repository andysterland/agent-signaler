<Window
    x:Class="AgentSignaler.Configurator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:local="using:AgentSignaler.Configurator"
    Title="Agent Signaler - Remote setup">
    <Grid x:Name="RootPanel" Margin="28" RowSpacing="14" MaxWidth="980" HorizontalAlignment="Stretch">
        <Grid.Resources>
            <DataTemplate x:Key="WrappingHeaderTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
            <Style TargetType="TextBox">
                <Setter Property="HeaderTemplate" Value="{StaticResource WrappingHeaderTemplate}" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="HeaderTemplate" Value="{StaticResource WrappingHeaderTemplate}" />
            </Style>
            <Style x:Key="ViewHelpButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="RegularLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootPanel.Margin" Value="14" />
                        <Setter Target="RootPanel.RowSpacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
                <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AgentSignalerAccentBrush}" VerticalAlignment="Center">
                    <Viewbox Margin="11">
                        <PathIcon Data="M12,1 L21,8 L18,21 L6,21 L3,8 Z M11,5 L8,11 L12,11 L9,18 L16,9 L12,9 Z" Foreground="White" />
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="HeadingText" Text="Agent Signaler" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AgentSignalerBrandTextBrush}" />
                    <TextBlock x:Name="VersionText" Opacity="0.72" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <TabView x:Name="TaskTabs" Grid.Row="1" SelectedIndex="0"
                 IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent">
            <TabViewItem x:Name="ConnectionTab" Header="Connection" AutomationProperties.Name="Connection" IsClosable="False">
                <Grid Padding="0,12,12,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ConnectionHelpButton" Grid.Column="1" Style="{StaticResource ViewHelpButtonStyle}"
                            AutomationProperties.Name="Connection help">
                        <SymbolIcon Symbol="Help" />
                        <ToolTipService.ToolTip>
                            <ToolTip Placement="Left" MaxWidth="440">
                                <StackPanel Spacing="10" MaxWidth="400">
                                    <TextBlock Text="Configure a connection to your dashboard. The heartbeat interval must be a whole number of minutes from 1 to 60. The persistent machine UUID is retained when integration or the application is removed." TextWrapping="Wrap" />
                                    <TextBlock Text="Client runs in the tray at user sign-in. Exit stops reporting until you explicitly start Client or sign in again. Start client uses saved settings." TextWrapping="Wrap" />
                                    <TextBlock Text="Select integrations on Hooks, then Apply settings and confirm the preview. Hook files and required profile settings are configured automatically. Opening, editing and testing do not change hooks or start Client." TextWrapping="Wrap" />
                                    <TextBlock Text="Legacy settings report status only. Applying settings explicitly upgrades to v5; upgrade Client, Relay and Configurator together first. Detailed sharing sends allowed user and assistant messages plus tool names, never tool arguments/results, raw errors or reasoning. Hook failures never block Copilot." TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <TextBox x:Name="UrlBox" Header="Dashboard base URL" PlaceholderText="http://desktop-pc:51820 or https://your-service-returned-host" TextChanged="SettingsChanged" />
                            <NumberBox x:Name="HeartbeatBox" Header="Heartbeat interval (minutes)" Value="5" Minimum="1" Maximum="60" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="HeartbeatChanged" />
                            <ToggleSwitch x:Name="ShareDetailsSwitch" Header="Share detailed conversations" IsOn="True"
                                          Toggled="ShareDetailsChanged" />
                            <TextBlock Text="Message text, including personal information, is sent to the configured Dashboard. Consent is handled outside the app. Requires HTTPS, a running upgraded Client, a compatible receiver and verified source capabilities. Apply settings to save; legacy settings stay status-only until this explicit v5 upgrade."
                                       TextWrapping="Wrap" />
                            <TextBlock Text="The anonymous prototype keeps details in bounded memory for up to 30 minutes at the receiver; this does not prevent OS paging or host history. Opt-out stops local capture immediately when applied. Remote purge is best effort, not an offline acknowledgement."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailedReportingText" TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeText" Text="Client runtime status has not been queried." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBox x:Name="IdentityBox" Header="Machine UUID" IsReadOnly="True" />
                            <Button x:Name="TestButton" Content="Test connection" Click="Test_Click" />
                            <Button x:Name="CancelTestButton" Content="Cancel test" Click="CancelTest_Click" IsEnabled="False" />
                            <Button x:Name="StartClientButton" Content="Start client" Click="StartClient_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>
            <TabViewItem x:Name="HooksTab" Header="Hooks" AutomationProperties.Name="Hooks" IsClosable="False">
                <Grid Padding="0,12,12,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HooksHelpButton" Grid.Column="1" Style="{StaticResource ViewHelpButtonStyle}"
                            AutomationProperties.Name="Hooks help">
                        <SymbolIcon Symbol="Help" />
                        <ToolTipService.ToolTip>
                            <ToolTip Placement="Left" MaxWidth="440">
                                <StackPanel Spacing="10" MaxWidth="400">
                                    <TextBlock Text="Select AgentSignaler.Relay.exe from the remote installation, with AgentSignaler.Client.exe beside it. Apply settings saves this path in remote.json and updates enabled hooks." TextWrapping="Wrap" />
                                    <TextBlock Text="Tick Enable for the locations you want, click Apply settings at the bottom right, then confirm the preview to save settings and write the hooks. Untick a saved location and apply to remove its owned hooks. Selection changes are not saved until you apply." TextWrapping="Wrap" />
                                    <TextBlock Text="Use Add custom location for additional paths: enter the hooks directory for CLI or Visual Studio, or the profile directory containing settings.json for VS Code. Local Windows only." TextWrapping="Wrap" />
                                    <TextBlock Text="Shared locations affect every host that loads them. Configuration does not prove event delivery or override host policy and workspace trust. Discovery is read-only; refreshing preserves unsaved selections." TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBox x:Name="RelayPathBox" Header="Remote relay location" PlaceholderText="Absolute path to AgentSignaler.Relay.exe" TextChanged="SettingsChanged" />
                            <TextBlock x:Name="DiscoveryText" Text="Discovering Copilot locations..." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="HookSelectionText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RefreshButton" Content="Refresh locations" Click="Refresh_Click" />
                            <Button x:Name="CancelDiscoveryButton" Content="Cancel discovery" Click="CancelDiscovery_Click" IsEnabled="False" />
                        </StackPanel>
                        <controls:DataGrid x:Name="HooksGrid" Grid.Row="2" AutoGenerateColumns="False"
                                           CanUserReorderColumns="False" CanUserSortColumns="False" IsReadOnly="True"
                                           HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                           AutomationProperties.Name="Copilot hook locations">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTemplateColumn Header="Enable" Width="76">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:HookTargetRow">
                                            <!-- The default 120-unit minimum clips the box in this narrow, label-free column. -->
                                            <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" HorizontalAlignment="Center"
                                                      MinWidth="0" Padding="0"
                                                      AutomationProperties.Name="{x:Bind DisplayName}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Copilot integration" Width="230">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:HookTargetRow">
                                            <StackPanel Margin="8" Spacing="4">
                                                <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                                <ComboBox ItemsSource="{x:Bind IntegrationKinds}" SelectedItem="{x:Bind Kind, Mode=OneWay}"
                                                          SelectionChanged="IntegrationKind_SelectionChanged"
                                                          Visibility="{x:Bind IsDraft}" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Custom integration type" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Local path" Width="*" MinWidth="220">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:HookTargetRow">
                                            <Grid Margin="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Location}" Visibility="{x:Bind IsLocationReadOnly}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           ToolTipService.ToolTip="{x:Bind Details}" />
                                                <TextBox Text="{x:Bind Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{x:Bind IsDraft}" HeaderTemplate="{x:Null}"
                                                         PlaceholderText="Absolute local path" ToolTipService.ToolTip="{x:Bind Details}"
                                                         AutomationProperties.Name="Hook directory or VS Code profile directory" />
                                            </Grid>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Status" Width="180">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:HookTargetRow">
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" Margin="8" VerticalAlignment="Center"
                                                       ToolTipService.ToolTip="{x:Bind Details}" />
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                        <Button x:Name="AddLocationButton" Grid.Row="3" Content="Add custom location" Click="AddLocation_Click" />
                    </Grid>
                </Grid>
            </TabViewItem>
            <TabViewItem x:Name="ReviewTab" Header="Review &amp; maintenance" AutomationProperties.Name="Review &amp; maintenance" IsClosable="False">
                <Grid Padding="0,12,12,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ReviewHelpButton" Grid.Column="1" Style="{StaticResource ViewHelpButtonStyle}"
                            AutomationProperties.Name="Review and maintenance help">
                        <SymbolIcon Symbol="Help" />
                        <ToolTipService.ToolTip>
                            <ToolTip Placement="Left" MaxWidth="440">
                                <StackPanel Spacing="10" MaxWidth="400">
                                    <TextBlock Text="Preview settings changes shows the exact planned changes without writing files. Apply settings always builds a fresh preview and asks for confirmation; a separate preview is optional." TextWrapping="Wrap" />
                                    <TextBlock Text="Recover an interrupted integration transaction to restore its prior owned files and startup settings. Clean up legacy diagnostic hooks before applying if diagnostic cleanup is pending. Changed user files are preserved." TextWrapping="Wrap" />
                                    <TextBlock Text="Uninstall integration removes this user's owned integrations and stops Client. The persistent machine UUID is retained. Each maintenance action asks for confirmation." TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <Button x:Name="PreviewButton" Content="Preview settings changes" Click="Preview_Click" />
                            <TextBox x:Name="PreviewBox" Header="Exact change preview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" MaxHeight="520" FontFamily="Consolas" />
                            <Button x:Name="RecoverIntegrationButton" Content="Recover interrupted integration transaction..." Click="RecoverIntegration_Click" />
                            <Button x:Name="RecoverVerificationButton" Content="Clean up legacy diagnostic hooks..." Click="RecoverVerification_Click" />
                            <Button x:Name="UninstallButton" Content="Uninstall integration..." Click="Uninstall_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>
        </TabView>
        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Polite">
            <InfoBar.Content>
                <ScrollViewer MaxHeight="96" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </InfoBar.Content>
        </InfoBar>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="ConfigPathText" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{Binding Text, ElementName=ConfigPathText}" />
                <TextBlock x:Name="RelayPathText" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{Binding Text, ElementName=RelayPathText}" />
            </StackPanel>
            <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply settings" Click="Apply_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
